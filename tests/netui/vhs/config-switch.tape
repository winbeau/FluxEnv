Set Shell bash
Set Width 1120
Set Height 560
Set FontSize 14
Set Theme { "name": "NetUI", "background": "#0f172a", "foreground": "#dbeafe", "black": "#111827", "brightBlack": "#475569", "red": "#f87171", "brightRed": "#fca5a5", "green": "#34d399", "brightGreen": "#6ee7b7", "yellow": "#fbbf24", "brightYellow": "#fde68a", "blue": "#38bdf8", "brightBlue": "#7dd3fc", "magenta": "#c084fc", "brightMagenta": "#d8b4fe", "cyan": "#22d3ee", "brightCyan": "#67e8f9", "white": "#e2e8f0", "brightWhite": "#f8fafc" }
Set TypingSpeed 0ms
Type "tput civis 2>/dev/null || true; bash tests/netui/visual/scene.sh config-switch"
Enter
Sleep 8s
